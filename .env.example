# 본인의 Railway PostgreSQL 접속 주소
DB_URL=postgresql://postgres:<password>@<host>:<port>/railway

# Claude API 키 (console.anthropic.com)
CLAUDE_API_KEY=sk-ant-...

# 한국투자증권 OpenAPI (계좌 개설 후 발급)
# 모의투자: https://apiportal.koreainvestment.com → 모의투자 앱 생성
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=00000000-01          # 계좌번호-상품코드
KIS_MODE=paper                   # paper | live

# DART 공시 API (dart.fss.or.kr → 인증키 신청, 무료)
DART_API_KEY=
